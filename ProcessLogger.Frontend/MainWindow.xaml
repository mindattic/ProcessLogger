<Window x:Class="ProcessLogger.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ProcessLogger" Height="700" Width="1200">
    <!-- Plain WebView2 + vanilla HTML/CSS/JS (wwwroot/index.html) - same hosting pattern as
         Automata.App / JobHunt.App: BlazorWebView was tried and abandoned for this combination
         (see Automata.App/MainWindow.xaml.cs), and native WPF controls can't be reliably themed
         for dark mode (their default templates paint chrome from system colors, not Setters). -->
    <wv2:WebView2 x:Name="Browser" />
</Window>
